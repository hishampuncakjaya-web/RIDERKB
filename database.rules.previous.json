{
  "rules": {
    "orders": {
      ".read": "auth != null && (auth.token.email == 'admin@riderkb.com' || root.child('riders').child(auth.uid).child('approved').val() === true)",
      ".indexOn": ["createdAt"],
      "$id": {
        ".read": true,
        ".write": "(!data.exists() && newData.child('status').val() == 'baru' && newData.hasChildren(['ref','createdAt','pick','drop','name','phone'])) || (auth != null && newData.exists() && root.child('riders').child(auth.uid).child('approved').val() === true && (data.child('status').val() != 'baru' || newData.child('status').val() == 'baru' || (newData.child('need').val() == data.child('need').val() && (data.child('pay').val() != 'cash' || root.child('riders').child(auth.uid).child('wallet').val() >= data.child('need').val())))) || (auth != null && auth.token.email == 'admin@riderkb.com')",
        ".validate": "newData.child('status').val().matches(/^(baru|diterima|diambil|selesai|batal)$/)"
      }
    },
    "riders": {
      ".read": "auth != null && auth.token.email == 'admin@riderkb.com'",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.token.email == 'admin@riderkb.com'",
        "name":   { ".write": "auth != null && auth.uid == $uid" },
        "phone":  { ".write": "auth != null && auth.uid == $uid" },
        "email":  { ".write": "auth != null && auth.uid == $uid" },
        "reg":    { ".write": "auth != null && auth.uid == $uid" },
        "lat":    { ".write": "auth != null && auth.uid == $uid" },
        "lng":    { ".write": "auth != null && auth.uid == $uid" },
        "t":      { ".write": "auth != null && auth.uid == $uid" },
        "online": { ".write": "auth != null && auth.uid == $uid" },
        "spd":    { ".write": "auth != null && auth.uid == $uid" }
      }
    },
    "hazards": {
      ".read": "auth != null && (auth.token.email == 'admin@riderkb.com' || root.child('riders').child(auth.uid).child('approved').val() === true)",
      ".write": "auth != null && auth.token.email == 'admin@riderkb.com'"
    },
    "shops": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'admin@riderkb.com'"
    },
    "walletLog": {
      ".read": "auth != null && auth.token.email == 'admin@riderkb.com'",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.token.email == 'admin@riderkb.com'"
      }
    }
  }
}
