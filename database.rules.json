          },
          "note": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "$other": {
            ".validate": "false"
          }
        }
      }
    },
    "fcmTokens": {
      ".read": false,
      "$role": {
        "$uid": {
          "$tok": {
            ".write": "auth != null && auth.uid == $uid && ($role == 'rider' || $role == 'vendor' || ($role == 'admin' && (root.child('admins').child(auth.uid).val() === true || (auth.token.email == 'mnhzuan@gmail.com' && auth.token.email_verified === true))))",
            ".validate": "newData.isNumber() && $tok.length < 400"
          }
        }
      },
      "customer": {
        "$oid": {
          "$tok": {
            ".write": "root.child('orders').child($oid).child('status').val().matches(/^(baru|diterima|diambil)$/)",
            ".validate": "newData.isNumber() && $tok.length < 400"
          }
        }
      }
    },
    "orderContacts": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email == 'mnhzuan@gmail.com' && auth.token.email_verified === true))",
      "$id": {
        ".read": "auth != null && ((root.child('admins').child(auth.uid).val() === true || (auth.token.email == 'mnhzuan@gmail.com' && auth.token.email_verified === true)) || (root.child('riders').child(auth.uid).child('approved').val() === true && root.child('orders').child($id).child('riderUid').val() == auth.uid))",
        ".write": "(!data.exists() && !root.child('orders').child($id).exists() && newData.parent().parent().child('orders').child($id).child('status').val() == 'baru') || (auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email == 'mnhzuan@gmail.com' && auth.token.email_verified === true)))",
        ".validate": "newData.hasChildren(['phone','phoneKey'])",
        "phone": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "phoneKey": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{9,13}$/)"
        },
        "recv": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "admins": {
      ".read": false,
      ".write": false
    },
    "proofsP": {
      "$id": {
        ".read": true,
        ".write": "auth != null && ((root.child('admins').child(auth.uid).val() === true || (auth.token.email == 'mnhzuan@gmail.com' && auth.token.email_verified === true)) || (root.child('riders').child(auth.uid).child('approved').val() === true && root.child('orders').child($id).child('riderUid').val() == auth.uid))",
        ".validate": "newData.isString() && newData.val().length < 200000"
      }
    }
  }
}